/* BRIEFING */
const bfi=document.getElementById('bfi'),bfld=document.getElementById('bfld');
if(bfi){bfi.addEventListener('load',()=>bfld.classList.add('hide'));setTimeout(()=>bfld.classList.add('hide'),5000);}

/* GAME */
let score=0,timeLeft=18,active=false,gIv=null,tIv=null,combo=1,comboCount=0,comboTimer=null,hits=0,totalSpawned=0,bestCombo=1,elapsed=0,lastPN='';
const arena=document.getElementById('arena'),gover=document.getElementById('gover');
const gscEl=document.getElementById('gscore'),gtEl=document.getElementById('gtime');
const gtBox=document.getElementById('gtmrBox'),gcEl=document.getElementById('gcombo');
const ghEl=document.getElementById('ghits'),cFill=document.getElementById('cmbFill');
const cLbl=document.getElementById('cmbLbl'),gst0=document.getElementById('gst0');
const gcd=document.getElementById('gcd'),rkList=document.getElementById('rankList');
const syms=['\u2733','\u2726','\u274B','\u2605','\u25C8'];
const gcols=['#E8547C','#D4A847','#3ABDB0','#BBA8D6','#D94F1E','#C5D400','#F4EFC8'];
const RT=[[0,'Ainda aprendendo...'],[15,'Designer em formacao!'],[35,'Olho afiado!'],[60,'Tem talento!'],[90,'Designer nato!'],[130,'LENDA DO ASTERISCO!!']];
function getRkL(p){let l=RT[0][1];for(const[m,x]of RT)if(p>=m)l=x;return l;}

const SK='layerd_v5';
function lsR(){try{const v=localStorage.getItem(SK);return v?JSON.parse(v):[];}catch(e){return[];}}
function lsW(d){try{localStorage.setItem(SK,JSON.stringify(d));}catch(e){}}
async function rkRead(){
  try{if(window.storage&&typeof window.storage.get==='function'){const r=await window.storage.get(SK,true);if(r&&r.value){const p=JSON.parse(r.value);if(Array.isArray(p)){lsW(p);return p;}}}}catch(e){}
  try{const r=await fetch('/api/ranking',{signal:AbortSignal.timeout(3000)});if(r.ok){const d=await r.json();if(d.ok&&d.ranking){lsW(d.ranking);return d.ranking;}}}catch(e){}
  return lsR();
}
async function rkWrite(d){lsW(d);try{if(window.storage&&typeof window.storage.set==='function')await window.storage.set(SK,JSON.stringify(d),true);}catch(e){}}
async function addScore(name,pts){
  try{const r=await fetch('/api/ranking',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({score:pts,display_name:name,hits:hits,best_combo:bestCombo,accuracy:totalSpawned?Math.round(hits/totalSpawned*100):0}),signal:AbortSignal.timeout(4000)});if(r.ok){const d=await r.json();if(d.ok)return{ranking:d.ranking,pos:d.position};}}catch(e){}
  let r=await rkRead();const time=new Date().toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
  r.push({display_name:name,score:pts,played_at:time});r.sort((a,b)=>b.score-a.score);if(r.length>15)r=r.slice(0,15);await rkWrite(r);
  return{ranking:r,pos:r.findIndex(x=>x.display_name===name&&x.score===pts)+1};
}
function renderRanking(r,hl){
  if(!r||!r.length){rkList.innerHTML='<div class="rempty">Sem jogadores ainda. Seja o primeiro!</div>';return;}
  const med=['\u2733','\u2726','\u274B'];
  rkList.innerHTML=r.map((x,i)=>{
    const name=x.display_name||x.name||'Anonimo';const pts=x.score||x.pts||0;
    const me=name===hl;const cls=i<3?'ri-'+(i+1):'';const pos=i<3?med[i]:'#'+(i+1);
    return '<div class="ri '+cls+(me?' me':'')+'"><div class="rpos">'+pos+'</div><div class="rinfo"><div class="rname">'+name+(me?' \u2190 voce':'')+'</div><div class="rbadge">'+getRkL(pts)+'</div></div><div class="rpts">'+pts+'</div></div>';
  }).join('');
}
async function initRk(){renderRanking(await rkRead(),'');}initRk();
setInterval(async()=>{if(!active){const r=await rkRead();renderRanking(r,lastPN);}},9000);

function getPN(){return document.getElementById('pname').value.trim()||'Anonimo';}
function startGame(){
  lastPN=getPN();score=0;timeLeft=18;active=false;combo=1;comboCount=0;hits=0;totalSpawned=0;bestCombo=1;elapsed=0;
  gscEl.textContent='0';gtEl.textContent='18';ghEl.textContent='0';gtBox.classList.remove('low');gcEl.textContent='x1';cFill.style.width='0%';cLbl.textContent='';
  gover.style.display='none';gst0.classList.add('hide');document.getElementById('playBtn').disabled=true;
  arena.querySelectorAll('.gtgt,.popscr,.gpart').forEach(t2=>t2.remove());
  let cd=3;gcd.classList.add('show');gcd.innerHTML='<div class="gcdn">'+cd+'</div>';sfxCd();
  const iv=setInterval(()=>{cd--;if(cd>0){gcd.innerHTML='<div class="gcdn">'+cd+'</div>';sfxCd();}else if(cd===0){gcd.innerHTML='<div class="gcdn" style="color:var(--gold)">JA!</div>';sfxStart();}else{clearInterval(iv);gcd.classList.remove('show');gcd.innerHTML='';runGame();}},800);
}
function runGame(){active=true;gIv=setInterval(()=>{timeLeft--;elapsed++;gtEl.textContent=timeLeft;gtBox.classList.toggle('low',timeLeft<=5);if(timeLeft<=5&&timeLeft>0)sfxTick();if(timeLeft<=0)endGame();},1000);sched2();for(let i=0;i<4;i++)setTimeout(spawn,i*95);}
function sched2(){if(!active)return;spawn();const itv=Math.max(230,590-elapsed*25);tIv=setTimeout(sched2,itv);}
function particles(x,y,c){for(let i=0;i<6;i++){const p=document.createElement('div');p.className='gpart';const s=Math.random()*4.5+2;p.style.cssText='width:'+s+'px;height:'+s+'px;background:'+c+';left:'+x+'px;top:'+y+'px;transition:transform .42s ease-out,opacity .42s';arena.appendChild(p);const a=Math.random()*Math.PI*2,d=Math.random()*38+14;requestAnimationFrame(()=>{p.style.transform='translate('+Math.cos(a)*d+'px,'+Math.sin(a)*d+'px) scale(0)';p.style.opacity='0';});setTimeout(()=>{if(arena.contains(p))arena.removeChild(p);},460);}}
function hit(t2,pts,isB){
  if(!active)return;t2.classList.add('hit');
  const r=arena.getBoundingClientRect(),tr=t2.getBoundingClientRect();particles(tr.left-r.left+tr.width/2,tr.top-r.top+tr.height/2,t2.style.color||'#E8547C');
  if(isB){timeLeft+=3;gtEl.textContent=timeLeft;sfxBonus();const pop=document.createElement('div');pop.className='popscr';pop.textContent='+3s';pop.style.cssText='color:var(--teal);left:'+t2.style.left+';top:'+t2.style.top;arena.appendChild(pop);setTimeout(()=>{if(arena.contains(pop))arena.removeChild(pop);},650);setTimeout(()=>{if(arena.contains(t2))arena.removeChild(t2);},320);return;}
  hits++;ghEl.textContent=hits;const actual=pts*combo;score+=actual;gscEl.textContent=score;comboCount++;
  const lvl=comboCount>=3;if(lvl){combo=Math.min(combo+1,8);comboCount=0;}if(combo>bestCombo)bestCombo=combo;
  gcEl.textContent='x'+combo;cFill.style.width=(comboCount/3*100)+'%';if(combo>1)cLbl.textContent='COMBO x'+combo+'!';
  sfxHit(pts);if(lvl&&combo>1)setTimeout(()=>sfxComboUp(combo),72);
  clearTimeout(comboTimer);comboTimer=setTimeout(()=>{combo=1;comboCount=0;gcEl.textContent='x1';cFill.style.width='0%';cLbl.textContent='';},1600);
  const pop=document.createElement('div');pop.className='popscr';pop.textContent='+'+actual+(combo>1?' !':'');pop.style.cssText='left:'+t2.style.left+';top:'+t2.style.top;arena.appendChild(pop);
  setTimeout(()=>{if(arena.contains(pop))arena.removeChild(pop);},650);setTimeout(()=>{if(arena.contains(t2))arena.removeChild(t2);},320);
}
function spawn(){
  if(!active)return;totalSpawned++;const t2=document.createElement('div');t2.className='gtgt';
  const roll=Math.random();let pts,isB=false;
  if(roll<.08){isB=true;}else{const r2=Math.random();pts=r2<.15?3:r2<.45?2:1;}
  if(isB){t2.textContent='\u23F1';t2.style.cssText='color:#3ABDB0;font-size:26px';}
  else{t2.textContent=syms[Math.floor(Math.random()*syms.length)];t2.style.color=gcols[Math.floor(Math.random()*gcols.length)];t2.style.fontSize=(Math.random()*13+23)+'px';if(pts===3)t2.style.color='#FFD700';}
  t2.style.left=Math.random()*82+'%';t2.style.top=Math.random()*72+'%';
  const life=Math.max(660,(isB?1320:1420)-elapsed*27)+Math.random()*260;
  const gr=document.createElement('div');gr.className='gring';gr.style.animationDuration=life+'ms';t2.appendChild(gr);
  const oh=e=>{e.preventDefault();e.stopPropagation();hit(t2,pts,isB);};
  t2.addEventListener('click',oh);t2.addEventListener('touchstart',oh,{passive:false});
  arena.appendChild(t2);setTimeout(()=>{if(arena.contains(t2))arena.removeChild(t2);},life);
}
async function endGame(){
  active=false;clearInterval(gIv);clearTimeout(tIv);clearTimeout(comboTimer);
  gcd.classList.remove('show');gcd.innerHTML='';arena.querySelectorAll('.gtgt,.popscr,.gpart').forEach(t2=>t2.remove());
  const name=getPN();lastPN=name;const acc=totalSpawned?Math.round(hits/totalSpawned*100):0;
  document.getElementById('goPts').textContent=score;document.getElementById('goNm').textContent=name;
  document.getElementById('goRk').textContent=getRkL(score);
  document.getElementById('goStats').innerHTML='<div class="go-stat"><b>'+hits+'</b><span>acertos</span></div><div class="go-stat"><b>x'+bestCombo+'</b><span>combo</span></div><div class="go-stat"><b>'+acc+'%</b><span>precisao</span></div>';
  gover.style.display='flex';sfxOver();document.getElementById('goPos').textContent='Salvando...';document.getElementById('playBtn').disabled=false;
  const res=await addScore(name,score);
  if(res.pos>=1&&res.pos<=3)setTimeout(sfxRec,600);
  document.getElementById('goPos').textContent=res.pos?'Posicao #'+res.pos+' no ranking':'';renderRanking(res.ranking,name);
}
document.getElementById('playBtn').addEventListener('click',startGame);
document.getElementById('goBtn').addEventListener('click',()=>{gover.style.display='none';startGame();});
document.getElementById('pname').addEventListener('keydown',e=>{if(e.key==='Enter')startGame();});
document.body.classList.remove('lk');render();

