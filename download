<script>
/* LAYER'D ENGINE — ERAS (structure/logic unchanged from source build) */
const scenes=Array.from(document.querySelectorAll('.scene'));
const N=scenes.length;
const scroll=document.getElementById('scroll');
const pb=document.getElementById('pb');
const hn=document.getElementById('hn');
const dotsW=document.getElementById('dots');
const sh=document.getElementById('sh');
const BG={ink:'#0E0C1C',navy:'#1A1730',orange:'#D94F1E',lime:'#C5D400',rose:'#E8547C',gold:'#D4A847',teal:'#3ABDB0'};
const SL=()=>window.innerHeight*1.85;
function setH(){scroll.style.height=(N*SL()+window.innerHeight*.65)+'px';}
setH();addEventListener('resize',()=>{setH();bgResize();});
scenes.forEach((_,i)=>{const b=document.createElement('button');b.dataset.goto=i;dotsW.appendChild(b);});
const dots=Array.from(dotsW.children);
const wipes=Array.from(document.querySelectorAll('.wipe'));
const wl=[document.getElementById('wl1'),document.getElementById('wl2'),document.getElementById('wl3')];
const WW=["LAYER'D","\u2733 DESIGN","BRANDING","\u2733 SOCIAL","PROCESSO","\u2733 WORK","BRIEFING","\u2733 GAME","CONTATO"];
const irisEl=document.getElementById('iris'),ifl=document.getElementById('ifl');
const bdsEl=document.getElementById('bds'),bdsB=Array.from(bdsEl.children);
function buildWL(i){const w=(WW[i]||"LAYER'D")+' ';const t=(w.repeat(7)).trim();wl.forEach(l=>l.innerHTML=t.split(' ').map(x=>'<span style="padding-right:3rem">'+x+'</span>').join(''));}
let mouseX=0,mouseY=0;
addEventListener('mousemove',e=>{mouseX=e.clientX/window.innerWidth-.5;mouseY=e.clientY/window.innerHeight-.5;},{passive:true});
let curScene=-1;
function eo(t){return 1-Math.pow(1-t,3);}
function eio(t){return t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;}
function c01(v){return v<0?0:v>1?1:v;}
function lp(a,b,t){return a+(b-a)*t;}
let tY=window.scrollY,sY=window.scrollY;
function sTr(type,local){
  const p=eio(c01(1-Math.abs(local)));let tx=0,ty=0,sc=1,rot=0,bl=0;const s=local<=0?1:-1;
  switch(type){
    case 'fade':sc=lp(.97,1,p);break;
    case 'zoom':sc=lp(1.24,1,p);ty=(1-p)*34*s;break;
    case 'zoom-out':sc=lp(.8,1,p);break;
    case 'slide-up':ty=(1-eo(c01(1-Math.abs(local))))*105*s;break;
    case 'circle':sc=lp(.95,1,p);bl=(1-p)*3;break;
    case 'blinds':ty=(1-p)*25*s;break;
    case 'wipe':ty=(1-eo(c01(1-Math.abs(local))))*55*s;sc=lp(.97,1,p);break;
    default:ty=(1-eo(c01(1-Math.abs(local))))*78*s;
  }
  return{tx,ty,sc,rot,bl:(bl||(1-p)*2.5)};
}
function applyScene(scene,local,t){
  const layers=scene.querySelectorAll('[data-l]');const type=scene.dataset.trans||'slide-up';
  const al=Math.abs(local);scene.classList.toggle('live',al<1.08);
  const a=al<.42?1:c01(1-(al-.42)/.55);const T=sTr(type,local);
  scene.style.opacity=a;scene.style.zIndex=al<.5?5:2;
  scene.style.transform='translate3d('+T.tx+'px,'+T.ty+'px,0) scale('+T.sc+') rotate('+T.rot+'deg)';
  scene.style.filter=T.bl>.5?'blur('+T.bl.toFixed(1)+'px)':'none';
  layers.forEach((el,i)=>{
    const stg=i*.052;const p2=local<=0?c01((local+1)-stg):c01(1-local-stg*.36);
    const e=eo(c01(p2));const bTy=(1-e)*58*(local<=0?1:-1);
    const live=c01((al<.42?1:0)*e);
    const fy=Math.sin(t*.00082+i*.8)*3.2*live;const fx=Math.cos(t*.00068+i*1.1)*2.4*live;
    const px=mouseX*10*(1+(i%3)*.25)*live;const py=mouseY*7*(1+(i%3)*.25)*live;
    el.style.opacity=e;el.style.transform='translate3d('+(fx+px)+'px,'+(bTy+fy+py)+'px,0)';
  });
}
function clearOvr(){wipes.forEach(w=>{w.style.opacity='0';w.style.transform='translateX(-100%)';});irisEl.style.opacity='0';bdsEl.style.opacity='0';}
function runOvr(type,idx,wp){
  const color=BG[scenes[idx]?.dataset.bg||'ink'];
  wipes.forEach(w=>w.style.opacity='0');irisEl.style.opacity='0';bdsEl.style.opacity='0';
  if(type==='circle'){
    irisEl.style.opacity='1';ifl.style.background=color;
    const d=Math.hypot(innerWidth,innerHeight);
    const sc=wp<.5?eio(wp/.5)*d/10*2.4:(1-eio((wp-.5)/.5))*d/10*2.4;
    ifl.style.transform='translate(-50%,-50%) scale('+sc+')';
    if(wp>=.995)irisEl.style.opacity='0';
  } else if(type==='blinds'){
    bdsEl.style.opacity='1';
    bdsB.forEach((b,k)=>{b.style.background=color;const dd=k*.06;const loc=c01((wp-dd)/(1-dd));const sx=loc<.5?eio(loc/.5):1-eio((loc-.5)/.5);b.style.transform='scaleX('+sx+')';});
    if(wp>=.995)bdsEl.style.opacity='0';
  } else {
    buildWL(idx);
    wipes.forEach((w,k)=>{w.style.opacity='1';const dd=k*.13;const loc=c01((wp-dd)/(1-dd));const e=eio(loc);const fl=(k+idx)%2===0;let x=e<.5?(fl?-100:100)*(1-e/.5):(fl?100:-100)*((e-.5)/.5);w.style.transform='translateX('+x+'%)';});
    if(wp>=.995)wipes.forEach(w=>w.style.opacity='0');
  }
}
function setBg(idx){document.body.style.background=BG[scenes[idx]?.dataset.bg||'ink'];}
function render(t){
  t=t||performance.now();const len=SL();const sy=sY;
  pb.style.width=(c01(sy/(N*len))*100).toFixed(2)+'%';
  const fpos=sy/len;const idx=Math.max(0,Math.min(N-1,Math.floor(fpos+.0001)));const frac=c01(fpos-idx);
  for(let i=0;i<N;i++){const local=fpos-i;if(local<-1.12||local>1.12){scenes[i].classList.remove('live');scenes[i].style.opacity='0';continue;}applyScene(scenes[i],local,t);}
  setBg(idx);
  if(frac>=.42&&idx<N-1){const wp=c01((frac-.42)/.58);runOvr(scenes[idx+1].dataset.trans||'wipe',idx+1,wp);}else{clearOvr();}
  hn.textContent=String(idx+1).padStart(2,'0')+' / '+String(N).padStart(2,'0');
  dots.forEach((d,i)=>d.classList.toggle('on',i===idx));
  if(idx!==curScene){curScene=idx;if(window.__sc)window.__sc(idx);}
  sh.classList.toggle('hide',sy>55);
}
function loop(t){tY=window.scrollY;sY=lp(sY,tY,.082);if(Math.abs(tY-sY)<.3)sY=tY;drawBg(t);render(t);requestAnimationFrame(loop);}
requestAnimationFrame(loop);
function gotoScene(i){window.scrollTo({top:i*SL(),behavior:'smooth'});}
document.querySelectorAll('[data-goto]').forEach(el=>el.addEventListener('click',()=>{gotoScene(+el.dataset.goto);playUI('click');}));
dots.forEach(d=>d.addEventListener('click',()=>{gotoScene(+d.dataset.goto);playUI('click');}));

/* BG - eras palette blobs */
const bgC=document.getElementById('bgc'),bgX=bgC.getContext('2d');
let blobs=[],dust=[];
function bgResize(){bgC.width=innerWidth;bgC.height=innerHeight;}
bgResize();
function bgInit(){
  const pal=['#E8547C','#D4A847','#3ABDB0','#BBA8D6','#D94F1E','#4E6FD4','#C5D400'];
  blobs=[];for(let i=0;i<7;i++)blobs.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*180+100,c:pal[i%pal.length],ph:Math.random()*6,sp:.0001+Math.random()*.00012,ax:Math.random()*innerWidth*.24,ay:Math.random()*innerHeight*.24});
  dust=[];const n=innerWidth<640?16:30;for(let i=0;i<n;i++)dust.push({x:Math.random()*innerWidth,y:Math.random()*innerHeight,r:Math.random()*1.2+.3,vx:(Math.random()-.5)*.14,vy:(Math.random()-.5)*.14,a:Math.random()*.24+.06});
}
bgInit();
function drawBg(t){
  const w=bgC.width,h=bgC.height;if(!w)return;
  bgX.clearRect(0,0,w,h);bgX.globalCompositeOperation='lighter';
  for(const b of blobs){const cx=b.x+Math.cos(t*b.sp+b.ph)*b.ax+mouseX*22;const cy=b.y+Math.sin(t*b.sp*1.2+b.ph)*b.ay+mouseY*22;const g=bgX.createRadialGradient(cx,cy,0,cx,cy,b.r);g.addColorStop(0,b.c+'30');g.addColorStop(1,b.c+'00');bgX.fillStyle=g;bgX.beginPath();bgX.arc(cx,cy,b.r,0,7);bgX.fill();}
  bgX.globalCompositeOperation='source-over';
  for(const p of dust){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=w;if(p.x>w)p.x=0;if(p.y<0)p.y=h;if(p.y>h)p.y=0;bgX.globalAlpha=p.a;bgX.fillStyle='#F4EFC8';bgX.beginPath();bgX.arc(p.x,p.y,p.r,0,7);bgX.fill();}
  bgX.globalAlpha=1;
}
addEventListener('resize',()=>{bgResize();bgInit();});

