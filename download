/* ══════ OVERLAYS — internal scene transitions (kept functional) ══════ */
#wipes{position:fixed;inset:0;z-index:50;pointer-events:none;overflow:hidden}
.wipe{position:absolute;left:0;width:200%;height:34vh;display:flex;align-items:center;
  will-change:transform;transform:translateX(-100%)}
.wl{font-family:'Syne',sans-serif;font-weight:900;font-size:clamp(2rem,7vw,5.5rem);
  white-space:nowrap;text-transform:uppercase;letter-spacing:-.02em;
  padding-left:3vw;display:inline-flex;gap:3rem;user-select:none}
.wipe.w1{top:0;background:var(--or);color:var(--ink)}
.wipe.w2{top:33vh;background:var(--gr);color:var(--ink)}
.wipe.w3{top:66vh;background:var(--ink);color:var(--gr);height:34vh;border-top:3px solid var(--cr);border-bottom:3px solid var(--cr)}
#iris{position:fixed;inset:0;z-index:48;pointer-events:none;opacity:0}
#iris .if{position:absolute;top:50%;left:50%;width:10px;height:10px;border-radius:50%;transform:translate(-50%,-50%) scale(0)}
#bds{position:fixed;inset:0;z-index:48;pointer-events:none;display:flex;flex-direction:column;opacity:0}
#bds i{flex:1;transform:scaleX(0);transform-origin:left}
#bds i:nth-child(even){transform-origin:right}

/* cross-page wipe (only used briefly on entering/leaving the site) */
body{opacity:0}

/* ══════ HUD ══════ */
#pb{position:fixed;top:0;left:0;height:3px;width:0;background:var(--or);z-index:9000;border-radius:0 3px 3px 0}
#dots{position:fixed;right:1.4rem;top:50%;transform:translateY(-50%);z-index:60;
  display:flex;flex-direction:column;gap:11px}
#dots button{width:9px;height:9px;border-radius:50%;border:2px solid rgba(244,239,200,.3);background:transparent;
  cursor:none;padding:0;transition:all .3s var(--e1)}
#dots button.on{background:var(--or);border-color:var(--or);transform:scale(1.6)}
#hl{position:fixed;top:1.5rem;left:1.7rem;z-index:60;font-family:'Syne',sans-serif;
  font-weight:900;font-size:1.25rem;color:var(--cr);letter-spacing:-.02em;cursor:none}
#hl em{font-style:normal;color:var(--or)}
#hn{position:fixed;top:1.65rem;right:1.7rem;z-index:60;font-family:'Space Grotesk',monospace;
  font-size:.62rem;letter-spacing:.2em;color:var(--cr);opacity:.35;text-transform:uppercase}
#sh{position:fixed;bottom:1.8rem;left:50%;transform:translateX(-50%);z-index:60;
  display:flex;flex-direction:column;align-items:center;gap:6px;
  font-family:'Space Grotesk',monospace;font-size:.58rem;letter-spacing:.22em;
  text-transform:uppercase;color:var(--cr);opacity:.42;transition:opacity .5s}
#sh.hide{opacity:0;pointer-events:none}
.sln{width:1px;height:38px;background:linear-gradient(to bottom,var(--or),transparent);
  animation:sln 1.9s var(--e1) infinite}
@keyframes sln{0%{transform:scaleY(0);transform-origin:top;opacity:1}50%{transform:scaleY(1);transform-origin:top;opacity:1}100%{transform:scaleY(1);transform-origin:bottom;opacity:0}}
#snd{position:fixed;bottom:1.4rem;left:1.5rem;z-index:60;width:42px;height:42px;border-radius:50%;
  border:2px solid var(--cr);background:transparent;color:var(--cr);
  cursor:none;display:none;align-items:center;justify-content:center;transition:all .2s}
#snd.show{display:flex}
#snd:hover{background:var(--or);color:var(--ink);border-color:var(--or)}
#snd.muted{opacity:.3}
#snd .eq{display:inline-flex;gap:2px;align-items:flex-end;height:12px}
#snd .eq i{width:2px;background:currentColor;animation:eq .8s ease-in-out infinite}
#snd .eq i:nth-child(1){height:4px}#snd .eq i:nth-child(2){height:11px;animation-delay:.2s}#snd .eq i:nth-child(3){height:7px;animation-delay:.4s}
#snd.muted .eq i{animation:none;height:3px}
@keyframes eq{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}
@keyframes spin{to{transform:rotate(360deg)}}
.spin{display:inline-block;animation:spin 6s linear infinite}

/* ══════ HERO ══════ */
.hburst{position:absolute;left:50%;top:46%;width:min(70vw,640px);height:min(70vw,640px);
  transform:translate(-50%,-50%);border-radius:50%;z-index:2;pointer-events:none;
  background-image:radial-gradient(circle,var(--or) 2.4px,transparent 2.4px);
  background-size:16px 16px;
  mask-image:radial-gradient(circle,#000 0%,transparent 68%);
  -webkit-mask-image:radial-gradient(circle,#000 0%,transparent 68%);
  opacity:.16;animation:hspin 40s linear infinite}
@keyframes hspin{to{transform:translate(-50%,-50%) rotate(360deg)}}
.hlogo{font-family:'Syne',sans-serif;font-weight:900;
  font-size:clamp(3.4rem,14vw,11rem);line-height:.86;letter-spacing:-.04em;color:var(--cr);
  position:relative;z-index:3}
.hlogo .e{color:var(--or)}
.hlogo .stu{display:block;color:transparent;-webkit-text-stroke:1.5px rgba(244,239,200,.22);
  font-size:.52em;margin-top:.1em}
.reg{position:absolute;font-family:'Space Grotesk',monospace;font-size:9px;
  color:rgba(244,239,200,.14);pointer-events:none;z-index:1;letter-spacing:0}
.chiprow{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;justify-content:center}
.chip{display:inline-flex;align-items:center;gap:.4rem;font-family:'Space Grotesk',monospace;
  font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(244,239,200,.55);
  border:1px solid var(--line);border-radius:99px;padding:6px 14px}
.chip b{width:5px;height:5px;border-radius:50%;background:var(--gr);display:inline-block}
.herotk{position:absolute;bottom:0;left:0;right:0;z-index:4}

/* ══════ generic section heading inside scenes ══════ */
.shead{max-width:640px}
.shead .disp{margin-top:.9rem}

/* service cards on homepage reuse .cell but need number + arrow chrome */
.svcnum{font-family:'Syne',sans-serif;font-weight:900;font-size:1.1rem;opacity:.4;position:relative;z-index:2}
.cell:hover .svcnum{opacity:1}
.svcarrow{position:absolute;top:1.4rem;right:1.5rem;font-size:1.2rem;opacity:.25;
  transition:transform .35s var(--e1),opacity .3s;z-index:2}
.cell:hover .svcarrow{opacity:1;transform:rotate(-45deg) scale(1.15)}
.cell.or .svcarrow,.cell.gr .svcarrow,.cell.lv .svcarrow{color:var(--ink)}

/* ══════ BRIEFING ══════ */
.bf{width:100%;max-width:680px;border-radius:var(--radius);overflow:hidden;position:relative;
  border:2px solid var(--line);background:var(--panel)}
.bfbar{background:rgba(244,239,200,.05);border-bottom:2px solid var(--line);
  display:flex;gap:7px;align-items:center;padding:.75rem 1.1rem;
  font-family:'Space Grotesk',monospace;font-size:.65rem;text-transform:uppercase;
  color:rgba(244,239,200,.5);letter-spacing:.12em}
.bfbar b{margin-left:auto;color:var(--or)}
.bfdots{display:flex;gap:5px}
.bfdots span{width:8px;height:8px;border-radius:50%}
.bfdots span:nth-child(1){background:var(--or)}
.bfdots span:nth-child(2){background:var(--gr)}
.bfdots span:nth-child(3){background:var(--lv)}
.bfld{position:absolute;inset:0;top:41px;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:.6rem;background:#fff;z-index:2;transition:opacity .4s}
.bfld.hide{opacity:0;pointer-events:none}
.bfld span{font-family:'Space Grotesk',monospace;font-size:.65rem;opacity:.5;color:var(--ink)}
.bf iframe{display:block;width:100%;height:480px;border:0}
.bfalt{font-size:.75rem;opacity:.42;margin-top:.8rem;color:var(--cr)}
.bfalt a{color:var(--or);border-bottom:1px solid rgba(217,79,30,.3)}

/* ══════ GAME (functional structure kept, chrome rebuilt) ══════ */
.gwrap{display:grid;grid-template-columns:1fr 270px;gap:1rem;width:100%;max-width:960px;align-items:start}
.greg{display:flex;gap:.55rem;margin-bottom:.7rem}
.ginp{flex:1;background:rgba(244,239,200,.05);border:2px solid var(--line);border-radius:99px;
  color:var(--cr);font-family:'DM Sans',sans-serif;font-size:.9rem;
  padding:10px 16px;cursor:none;outline:none;transition:border-color .2s}
.ginp:focus{border-color:var(--or)}
.gplay{background:var(--or);color:var(--cr);border:2px solid var(--or);border-radius:99px;
  font-family:'Syne',sans-serif;font-weight:800;padding:10px 20px;text-transform:uppercase;
  font-size:.78rem;cursor:none;white-space:nowrap;letter-spacing:.05em;
  box-shadow:4px 4px 0 var(--gr);transition:transform .2s,box-shadow .2s}
.gplay:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--gr)}
.gplay:disabled{opacity:.25;box-shadow:none}
.arena{height:310px;background:rgba(244,239,200,.02);border:2px solid var(--line);border-radius:var(--radius);
  position:relative;overflow:hidden}
.gtgt{position:absolute;cursor:none;user-select:none;font-weight:900;
  display:flex;align-items:center;justify-content:center}
.gtgt .gring{position:absolute;width:140%;height:140%;border-radius:50%;border:2px solid currentColor;
  opacity:.2;animation:gring linear forwards}
@keyframes gring{from{transform:scale(1.4);opacity:.35}to{transform:scale(.4);opacity:0}}
.gtgt.hit{animation:gexp .3s forwards;pointer-events:none}
@keyframes gexp{0%{transform:scale(1);opacity:1}60%{transform:scale(2.2);opacity:.25}100%{transform:scale(0);opacity:0}}
.gpart{position:absolute;pointer-events:none;border-radius:50%}
.popscr{position:absolute;pointer-events:none;font-family:'Syne',sans-serif;font-weight:900;
  font-size:.95rem;color:var(--gr);animation:popup .62s forwards;text-shadow:2px 2px 0 var(--ink)}
@keyframes popup{0%{transform:translateY(0);opacity:1}100%{transform:translateY(-42px);opacity:0}}
.gcd{position:absolute;inset:0;display:none;align-items:center;justify-content:center;
  z-index:18;background:rgba(14,12,28,.8)}
.gcd.show{display:flex}
.gcdn{font-family:'Syne',sans-serif;font-weight:900;font-size:5rem;color:var(--or);
  text-shadow:4px 4px 0 rgba(197,212,0,.3);animation:cdp .72s var(--e1)}
@keyframes cdp{0%{transform:scale(.2);opacity:0}50%{transform:scale(1.06);opacity:1}100%{transform:scale(.5);opacity:0}}
.gst0{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
  justify-content:center;text-align:center;padding:1.5rem;background:rgba(14,12,28,.82);
  z-index:15;transition:opacity .35s}
.gst0.hide{opacity:0;pointer-events:none}
.gst0 .gi{font-size:1.9rem;color:var(--or);margin-bottom:.65rem}
.gst0 .gt{font-family:'Syne',sans-serif;font-weight:800;color:var(--or);margin-bottom:.35rem;font-size:.9rem}
.gst0 .gs{font-size:.72rem;opacity:.5;line-height:1.62;max-width:268px;color:var(--cr)}
.gover{display:none;position:absolute;inset:0;background:rgba(14,12,28,.97);
  flex-direction:column;align-items:center;justify-content:center;gap:.45rem;
  z-index:20;padding:1rem;text-align:center}
.go-pts{font-family:'Syne',sans-serif;font-weight:900;font-size:3.2rem;color:var(--or);
  text-shadow:3px 3px 0 rgba(197,212,0,.2);line-height:1}
.go-nm{font-family:'Syne',sans-serif;font-weight:800;color:var(--gr);font-size:1rem}
.go-rk{font-size:.74rem;opacity:.5;margin-bottom:.2rem;color:var(--cr)}
.go-stats{display:flex;gap:1.1rem}
.go-stat b{display:block;font-family:'Syne',sans-serif;font-weight:900;font-size:1.1rem;color:var(--cr)}
.go-stat span{font-family:'Space Grotesk',monospace;font-size:.52rem;text-transform:uppercase;opacity:.45;color:var(--cr)}
.go-pos{font-family:'Space Grotesk',monospace;font-size:.68rem;color:var(--lv);margin-top:.2rem}
.go-btn{background:var(--or);color:var(--cr);border:2px solid var(--or);border-radius:99px;
  font-family:'Syne',sans-serif;font-weight:800;padding:10px 24px;text-transform:uppercase;
  cursor:none;margin-top:.5rem;font-size:.78rem;letter-spacing:.05em;
  box-shadow:4px 4px 0 var(--gr);transition:transform .2s,box-shadow .2s}
.go-btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--gr)}
.gbar{display:flex;gap:.4rem;margin-top:.6rem}
.gst{flex:1;border:2px solid var(--line);border-radius:12px;padding:6px 7px;text-align:center;
  font-family:'Space Grotesk',monospace;font-size:.6rem;color:rgba(244,239,200,.5)}
.gst b{color:var(--or);display:block;font-size:.85rem;font-weight:700}
.gtmr{flex:1;background:var(--or);color:var(--cr);border:2px solid var(--or);border-radius:12px;
  padding:6px 7px;text-align:center;font-family:'Space Grotesk',monospace;font-size:.6rem}
.gtmr b{display:block;font-size:.85rem}
.gtmr.low b{animation:bl .35s infinite}
@keyframes bl{50%{opacity:.1}}
.cbar{height:4px;background:var(--line);margin-top:.5rem;overflow:hidden;border-radius:4px}
.cfill{height:100%;width:0;background:var(--or);transition:width .08s}
.clbl{font-family:'Space Grotesk',monospace;font-size:.58rem;color:var(--or);
  text-align:right;min-height:.85rem;margin-top:.18rem}
.rankp{border:2px solid var(--or);border-radius:var(--radius);background:rgba(217,79,30,.04);overflow:hidden}
.rankh{background:var(--or);padding:.65rem 1rem;display:flex;justify-content:space-between;align-items:center}
.rankh h3{font-family:'Syne',sans-serif;font-weight:900;font-size:.7rem;
  text-transform:uppercase;color:var(--ink)}
.rankl{padding:.5rem;display:flex;flex-direction:column;gap:3px;max-height:250px;overflow-y:auto}
.ri{display:flex;align-items:center;gap:.5rem;padding:.45rem .55rem;border-radius:12px;
  border:1px solid var(--line2)}
.ri.me{border-color:var(--or);background:rgba(217,79,30,.08)}
.rpos{font-family:'Syne',sans-serif;font-weight:900;width:18px;text-align:center;opacity:.35;font-size:.72rem;color:var(--cr)}
.ri-1 .rpos{color:#FFD700;opacity:1}.ri-2 .rpos{color:#C0C0C0;opacity:1}.ri-3 .rpos{color:#CD7F32;opacity:1}
.rinfo{flex:1;min-width:0}
.rname{font-family:'Syne',sans-serif;font-weight:700;font-size:.74rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--cr)}
.rbadge{font-family:'Space Grotesk',monospace;font-size:.5rem;opacity:.4;color:var(--cr)}
.rpts{font-family:'Syne',sans-serif;font-weight:900;color:var(--or);font-size:.8rem}
.rempty,.rload{text-align:center;padding:1.4rem .9rem;opacity:.35;font-size:.7rem;color:var(--cr)}

/* homepage contact: 4 cards */
.ccrow.four{grid-template-columns:repeat(4,1fr)}

/* RESPONSIVE (page-specific) */
@media(max-width:820px){
  .gwrap{grid-template-columns:1fr}
  .ccrow.four{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  #cur,#curt{display:none!important}
  .btn,.gplay,.gtgt,.go-btn,#snd,#dots button,.cell,.mq{cursor:pointer!important}
  .ginp{cursor:text!important}
  #dots{right:.6rem;gap:8px}#dots button{width:7px;height:7px}
  .scene{padding:3.6rem 1.1rem}
  .si{gap:1.05rem}
  .arena{height:270px}
  .greg{flex-direction:column}.gplay{width:100%}
  .bf iframe{height:50vh}
  #hn{display:none}
  .ccrow.four{grid-template-columns:1fr}
}
</style>
