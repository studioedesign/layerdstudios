/* AUDIO */
let actx=null,master=null,mMaster=null,soundOn=false,mPlaying=false;
let mOscs=[],mLfos=[],rev=null,melTmr=null;
function initA(){if(actx)return;try{actx=new(window.AudioContext||window.webkitAudioContext)();master=actx.createGain();master.gain.value=0;master.connect(actx.destination);mMaster=actx.createGain();mMaster.gain.value=0;mMaster.connect(actx.destination);}catch(e){actx=null;}}
function makeRev(){if(!actx)return null;const len=actx.sampleRate*4,buf=actx.createBuffer(2,len,actx.sampleRate);for(let c=0;c<2;c++){const d=buf.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2.5);}const cv=actx.createConvolver();cv.buffer=buf;return cv;}
const MEL=[110,130.81,146.83,164.81,196,220,174.61];
function startMusic(){if(!actx||mPlaying)return;mPlaying=true;rev=makeRev();if(rev){const rg=actx.createGain();rg.gain.value=.38;rev.connect(rg);rg.connect(mMaster);}const mf=actx.createBiquadFilter();mf.type='lowpass';mf.frequency.value=400;mf.Q.value=.5;mf.connect(mMaster);if(rev)mf.connect(rev);
  [{f:55,v:.05,ls:.024,lv:.009},{f:82.41,v:.037,ls:.029,lv:.008},{f:110,v:.028,ls:.018,lv:.007},{f:110.18,v:.024,ls:.016,lv:.006},{f:164.81,v:.017,ls:.021,lv:.005}].forEach((p,i)=>{const o=actx.createOscillator(),g=actx.createGain();o.type='sine';o.frequency.value=p.f;g.gain.value=0;o.connect(g);g.connect(mf);o.start();g.gain.linearRampToValueAtTime(p.v,actx.currentTime+5+i*.65);const lfo=actx.createOscillator(),lg=actx.createGain();lfo.frequency.value=p.ls;lg.gain.value=p.lv;lfo.connect(lg);lg.connect(g.gain);lfo.start();mOscs.push(o);mLfos.push(lfo);});
  schedMel();}
function schedMel(){if(!actx||!mPlaying)return;melTmr=setTimeout(()=>{if(actx&&mPlaying&&soundOn)playMel();schedMel();},4800+Math.random()*5200);}
function playMel(){if(!actx||!soundOn)return;const freq=MEL[Math.floor(Math.random()*MEL.length)];const dur=2+Math.random()*3;const o=actx.createOscillator(),g=actx.createGain(),fl=actx.createBiquadFilter();fl.type='lowpass';fl.frequency.value=260;o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(0,actx.currentTime);g.gain.linearRampToValueAtTime(.022,actx.currentTime+.4);g.gain.exponentialRampToValueAtTime(.0001,actx.currentTime+dur);o.connect(fl);fl.connect(g);g.connect(mMaster);if(rev)g.connect(rev);o.start();o.stop(actx.currentTime+dur+.2);}
function setMV(v,t2){if(!actx||!mMaster)return;mMaster.gain.cancelScheduledValues(actx.currentTime);mMaster.gain.linearRampToValueAtTime(v,actx.currentTime+(t2||.5));}
function tone(f,d,tp,v,w){if(!actx||!soundOn)return;const t2=w||actx.currentTime;const o=actx.createOscillator(),g=actx.createGain();o.type=tp||'sine';o.frequency.value=f;g.gain.value=0;o.connect(g);g.connect(master);g.gain.linearRampToValueAtTime(v||.11,t2+.01);g.gain.exponentialRampToValueAtTime(.0001,t2+(d||.15));o.start(t2);o.stop(t2+(d||.15)+.02);}
function chord(fs,gap,d,tp,v){if(!actx||!soundOn)return;fs.forEach((f,i)=>tone(f,d||.17,tp||'sine',v||.1,actx.currentTime+i*(gap||.052)));}
function sfxHit(p){if(!actx||!soundOn)return;const f=p===3?880:p===2?660:440;const t2=actx.currentTime;const o=actx.createOscillator(),g=actx.createGain();o.type='sine';o.frequency.setValueAtTime(f*1.3,t2);o.frequency.exponentialRampToValueAtTime(f,t2+.06);g.gain.setValueAtTime(.19,t2);g.gain.exponentialRampToValueAtTime(.0001,t2+.17);o.connect(g);g.connect(master);o.start(t2);o.stop(t2+.19);}
function sfxComboUp(lvl){if(!actx||!soundOn)return;const t2=actx.currentTime,b=220*Math.pow(1.2,lvl-1);[b,b*1.25,b*1.5].forEach((f,i)=>{const o=actx.createOscillator(),g=actx.createGain();o.type='triangle';o.frequency.value=f;g.gain.setValueAtTime(0,t2+i*.05);g.gain.linearRampToValueAtTime(.11,t2+i*.05+.01);g.gain.exponentialRampToValueAtTime(.0001,t2+i*.05+.19);o.connect(g);g.connect(master);o.start(t2+i*.05);o.stop(t2+i*.05+.21);});}
function sfxBonus(){if(!actx||!soundOn)return;const t2=actx.currentTime,o=actx.createOscillator(),g=actx.createGain();o.type='sine';o.frequency.setValueAtTime(330,t2);o.frequency.exponentialRampToValueAtTime(880,t2+.26);g.gain.setValueAtTime(.15,t2);g.gain.exponentialRampToValueAtTime(.0001,t2+.36);o.connect(g);g.connect(master);o.start(t2);o.stop(t2+.4);}
function sfxCd(){if(!actx||!soundOn)return;tone(440,.09,'triangle',.13);}
function sfxStart(){if(!actx||!soundOn)return;chord([261.63,329.63,392,523.25],.062,.26,'triangle',.11);}
function sfxOver(){if(!actx||!soundOn)return;chord([392,329.63,261.63,196],.11,.38,'sine',.14);}
function sfxTick(){if(!actx||!soundOn)return;tone(180,.06,'square',.07);}
function sfxRec(){if(!actx||!soundOn)return;chord([523.25,659.26,783.99,1046.5],.065,.34,'triangle',.13);}
function playUI(tp){if(!actx||!soundOn)return;switch(tp){case 'hover':tone(660,.06,'sine',.038);break;case 'click':tone(550,.08,'triangle',.075);tone(825,.08,'triangle',.075,actx.currentTime+.028);break;case 'toggle':chord([392,523],.065,.1,'sine',.09);break;case 'scene':tone(330+Math.random()*100,.1,'sine',.045);break;}}
window.playUI=playUI;
function syncSnd(){document.getElementById('snd').classList.toggle('muted',!soundOn);if(actx&&master)master.gain.linearRampToValueAtTime(soundOn?.36:0,actx.currentTime+.28);setMV(soundOn?.4:0,.65);}
document.getElementById('snd').addEventListener('click',()=>{if(!actx)initA();if(actx&&actx.state==='suspended')actx.resume();soundOn=!soundOn;if(soundOn&&!mPlaying)startMusic();syncSnd();if(soundOn)playUI('toggle');});
function fg(){initA();if(actx&&actx.state==='suspended')actx.resume();soundOn=true;startMusic();setMV(.4,5);syncSnd();document.getElementById('snd').classList.add('show');document.removeEventListener('pointerdown',fg,{once:true});}
document.addEventListener('pointerdown',fg,{once:true});
window.__sc=i=>{playUI('scene');};
