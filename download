#scroll{position:relative;width:100%}
#stage{position:fixed;inset:0;overflow:hidden;z-index:1}
#bgc{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.4}
body.lk{overflow:hidden;height:100vh}
.scene{position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  padding:clamp(1.5rem,5vw,5rem);opacity:0;visibility:hidden;will-change:transform,opacity}
